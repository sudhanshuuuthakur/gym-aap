{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://cyyaltxyfuqrzhxtsnbt.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "gym-aap",
      "version": "0.1.0",
      "title": "gym aap"
    },
    "tools": [
      {
        "name": "gym_summary",
        "title": "Gym overview summary",
        "description": "Summarize the signed-in gym owner's gym: total members, paid vs unpaid counts, revenue collected, and check-ins over a recent window.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "days": {
              "type": "integer",
              "description": "Window in days for revenue and attendance totals (default 30)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_members",
        "title": "List gym members",
        "description": "List the signed-in gym owner's members (admissions), optionally filtered by payment status or a name/phone search.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "all",
                "paid",
                "unpaid"
              ],
              "description": "Filter by membership payment status. Defaults to all."
            },
            "search": {
              "type": "string",
              "description": "Match against member name or phone."
            },
            "limit": {
              "type": "integer",
              "description": "Max members to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_member",
        "title": "Add gym member",
        "description": "Register a new gym member (admission) for the signed-in gym owner. Name and phone are required.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Member full name."
            },
            "phone": {
              "type": "string",
              "description": "10-digit phone number."
            },
            "join_date": {
              "type": "string",
              "description": "Date of joining as YYYY-MM-DD."
            },
            "age": {
              "type": "integer",
              "description": "Member age in years."
            },
            "height": {
              "type": "number",
              "description": "Height in cm."
            },
            "weight": {
              "type": "number",
              "description": "Weight in kg."
            }
          },
          "required": [
            "name",
            "phone"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "record_payment",
        "title": "Record membership payment",
        "description": "Record a membership payment for one of the signed-in gym owner's members and mark that member as paid.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "member_id": {
              "type": "string",
              "description": "The member's admission id (UUID) from list_members."
            },
            "amount": {
              "type": "number",
              "description": "Payment amount collected."
            },
            "method": {
              "type": "string",
              "description": "Payment method, e.g. cash or upi. Defaults to cash."
            },
            "payment_date": {
              "type": "string",
              "description": "Payment date as YYYY-MM-DD. Defaults to today."
            },
            "notes": {
              "type": "string",
              "description": "Optional note about this payment."
            }
          },
          "required": [
            "member_id",
            "amount"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "mark_attendance",
        "title": "Mark member attendance",
        "description": "Check a member in for a given day (defaults to today) for the signed-in gym owner.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "member_id": {
              "type": "string",
              "description": "The member's admission id (UUID) from list_members."
            },
            "check_in_date": {
              "type": "string",
              "description": "Check-in date as YYYY-MM-DD. Defaults to today."
            },
            "notes": {
              "type": "string",
              "description": "Optional note for this check-in."
            }
          },
          "required": [
            "member_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
